{
	"name": "tracy/tracy",
	"description": "😎 Tracy: the addictive PHP debugger. Clear error pages with full context, a debug bar, readable dumps, AJAX and CLI support, and logging with e-mail alerts in production.",
	"keywords": ["tracy", "nette", "debugger", "debugging", "debug bar", "error handler", "dump", "var_dump", "logging", "whoops"],
	"homepage": "https://tracy.nette.org",
	"license": ["BSD-3-Clause"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.2 - 8.6",
		"ext-session": "*",
		"ext-json": "*"
	},
	"require-dev": {
		"nette/utils": "^3.0 || ^4.0",
		"nette/di": "^3.0",
		"nette/http": "^3.0",
		"nette/mail": "^3.0 || ^4.0",
		"nette/tester": "^2.6",
		"latte/latte": "^2.5 || ^3.0",
		"psr/log": "^1.0 || ^2.0 || ^3.0",
		"phpstan/phpstan": "^2.3@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0"
	},
	"conflict": {
		"nette/di": "<3.0"
	},
	"autoload": {
		"classmap": ["src"],
		"files": ["src/Tracy/functions.php"],
		"psr-4": {
			"Tracy\\": "src"
		}
	},
	"minimum-stability": "dev",
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests",
		"compile-templates": "@php tools/latte-convert/compile.php src/Tracy"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "2.12-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
